# ── Frontend (Vite) — Koperasi Syariah K-Samara ──────────────────────────

# Base URL API Laravel. Di dev, request lewat proxy Vite (/api → localhost:8000),
# jadi nilai ini hanya dipakai sebagai fallback.
VITE_API_URL=http://localhost:8000/api

# URL panel admin (Filament) — dipakai untuk redirect admin/superadmin
VITE_BACKEND_URL=http://localhost:8000

# Midtrans Snap (client key sandbox/production)
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# Google OAuth — Client ID dari Google Cloud Console (tipe "Web application").
# Wajib diisi agar tombol "Masuk dengan Google" berfungsi.
# Daftarkan origin frontend sebagai Authorized JavaScript origin,
# mis. http://localhost:5173 dan https://app.domain.com
VITE_GOOGLE_CLIENT_ID=

# Catatan PWA:
# - Manifest & service worker digenerate vite-plugin-pwa (lihat vite.config.js).
# - Prompt install hanya muncul di localhost atau HTTPS (bukan http://IP-LAN).
# - Verifikasi hasil build dengan: npm run build && npm run preview
